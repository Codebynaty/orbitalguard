# OrbitalGuard — variáveis de ambiente (NÃO comitar o .env real!)
# Copie este arquivo para .env e preencha com seus valores.

# Copernicus Data Space (https://dataspace.copernicus.eu)
COPERNICUS_USER=seu-email@exemplo.com
COPERNICUS_PASS=sua-senha-aqui

# Google Earth Engine
GEE_PROJECT=seu-projeto-gee

# Backend — URL pública da API (usado pelo frontend em produção)
# REACT_APP_API_URL=https://sua-api.onrender.com
